# Worker image: the only image with ffmpeg/yt-dlp baked in, since it's the
# only process that ever touches raw media bytes/subprocesses.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
COPY scripts ./scripts

RUN mkdir -p /storage/downloads /storage/processed /storage/temp \
    && chown -R appuser:appuser /storage /app

USER appuser

CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=INFO"]
