# --- Telegram ---
# Get this from @BotFather on Telegram (/newbot). See README "Getting a bot token".
TELEGRAM_BOT_TOKEN=

# "cloud" = api.telegram.org (50MB upload / 20MB download limits)
# "local" = self-hosted Local Bot API Server (2000MB upload, effectively unlimited download)
TELEGRAM_API_MODE=cloud
LOCAL_BOT_API_BASE_URL=http://telegram-bot-api:8081

# Only required if TELEGRAM_API_MODE=local. From https://my.telegram.org/apps
# (a personal account's API credentials, NOT the bot token).
LOCAL_BOT_API_ID=
LOCAL_BOT_API_HASH=

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=media_bot
POSTGRES_USER=media_bot
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://media_bot:${POSTGRES_PASSWORD}@postgres:5432/media_bot

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_BROKER=0
REDIS_DB_RESULT_BACKEND=1
REDIS_DB_CACHE=2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Storage ---
STORAGE_ROOT=/storage
DOWNLOADS_DIR=${STORAGE_ROOT}/downloads
PROCESSED_DIR=${STORAGE_ROOT}/processed
TEMP_DIR=${STORAGE_ROOT}/temp
TEMP_FILE_TTL_HOURS=24

# --- Limits ---
MAX_FILE_SIZE_MB=1900
MAX_DURATION_SECONDS=18000
MAX_PROCESSING_TIME_SECONDS=3600
MAX_CONCURRENT_TASKS_PER_USER=2
MIN_FREE_DISK_MB=2048
PROGRESS_POLL_INTERVAL_SECONDS=2.5
MIN_EDIT_INTERVAL_SECONDS=3

# --- App ---
ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console
